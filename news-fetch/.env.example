# News API Configuration
NEWS_API_KEYS=key1,key2
NEWS_API_KEY=

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=news_pipeline

# FalkorDB Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=worldgraph

# Groq / LLM Configuration
GROQ_API_KEYS=key1,key2
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_REQUESTS_PER_MINUTE=8

# Temporal Linker Configuration
TEMPORAL_WINDOW_DAYS=3
TEMPORAL_SIMILARITY_THRESHOLD=0.70
DATE_FROM=2026-09-08
DATE_TO=2026-10-07

# Embedding & Clustering Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
DBSCAN_EPS=0.35
DBSCAN_MIN_SAMPLES=2
SIMHASH_DISTANCE_THRESHOLD=1

# General Pipeline Settings
DEFAULT_QUERY=*
DEFAULT_LANGUAGE=en
LOG_LEVEL=INFO
